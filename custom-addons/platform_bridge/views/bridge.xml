<odoo>
  <template id="platform_login" inherit_id="web.login">
    <xpath expr="//div[@id='oe_structure_login_bottom']" position="before">
      <div class="text-center mt-3" t-if="request.env['pe.bridge.config'].sudo()._config().enabled">
        <a href="/platform/login" class="btn btn-outline-primary w-100">Sign in with Platform Engineer</a>
      </div>
    </xpath>
  </template>
</odoo>
