<odoo>
  <record id="view_contact_sync_list" model="ir.ui.view">
    <field name="name">Platform contact synchronization</field>
    <field name="model">pe.bridge.link</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0">
        <field name="name"/><field name="visibility"/><field name="status"/><field name="partner_id"/>
      </list>
    </field>
  </record>
  <record id="view_contact_sync_form" model="ir.ui.view">
    <field name="name">Platform contact synchronization review</field>
    <field name="model">pe.bridge.link</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <sheet>
          <group><field name="name"/><field name="partner_id"/><field name="visibility"/><field name="status"/></group>
          <p>Conflicting edits are retained for review. No record is merged or deleted automatically. Sharing and verified account details are managed in Platform Engineer.</p>
          <field name="review_details" nolabel="1"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_contact_sync" model="ir.actions.act_window">
    <field name="name">Contact synchronization</field><field name="res_model">pe.bridge.link</field><field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_contact_sync" name="Contact synchronization" action="action_contact_sync" groups="base.group_user" sequence="160"/>
  <record id="view_partner_bridge_fields" model="ir.ui.view">
    <field name="name">Platform contact fields</field><field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group string="Platform Engineer" invisible="not pe_managed">
          <field name="pe_managed" invisible="1"/>
          <field name="pe_first_name" string="First name"/><field name="pe_last_name" string="Last name"/>
          <field name="pe_mobile_phone"/><field name="pe_company" string="Company"/>
          <field name="pe_visibility" string="Sharing"/><field name="pe_opt_out" string="Do not contact"/>
          <p>Sharing changes require the existing Platform Engineer contact controls. Do not send communications to a contact marked Do not contact.</p>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
